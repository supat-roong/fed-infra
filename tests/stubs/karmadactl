#!/usr/bin/env bash
set -euo pipefail
echo "karmadactl $*" >> "$STUB_LOG"
# Unquoted by design: STUB_KARMADACTL_FAIL_GLOB is a shell glob pattern, not a
# literal string, so only matching subcommands fail.
# shellcheck disable=SC2254
case "$*" in
  ${STUB_KARMADACTL_FAIL_GLOB:-__never_matches__}) exit 1 ;;
esac
[ -n "${STUB_KARMADACTL_OUT:-}" ] && printf '%s' "$STUB_KARMADACTL_OUT"
exit 0
