#!/usr/bin/env bash
set -euo pipefail
echo "docker $*" >> "$STUB_LOG"
# Unquoted by design: STUB_DOCKER_FAIL_GLOB is a shell glob pattern, not a
# literal string, so only matching subcommands fail.
# shellcheck disable=SC2254
case "$*" in
  ${STUB_DOCKER_FAIL_GLOB:-__never_matches__}) exit 1 ;;
esac
# Default keeps `docker image inspect --format '{{.Id}}'` non-empty when a
# caller (e.g. fed_kind_load_image) parses stdout for a 12-char image id and
# no test has opted into a specific value via STUB_DOCKER_OUT.
printf '%s' "${STUB_DOCKER_OUT:-sha256:000000000000}"
exit 0
