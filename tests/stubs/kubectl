#!/usr/bin/env bash
set -euo pipefail
echo "kubectl $*" >> "$STUB_LOG"
# Unquoted by design: STUB_KUBECTL_FAIL_GLOB is a shell glob pattern, not a
# literal string, so only matching subcommands fail.
# shellcheck disable=SC2254
case "$*" in
  ${STUB_KUBECTL_FAIL_GLOB:-__never_matches__}) exit 1 ;;
esac
# STUB_KUBECTL_FAIL_ONCE_GLOB + STUB_KUBECTL_FAIL_ONCE_COUNT (default 1) let
# a test express "fail the first N matching calls, then succeed" — used to
# exercise fed_retry-based polling without a fixed sleep. Kept independent
# of STUB_KUBECTL_FAIL_GLOB above so a test can permanently fail one probe
# (e.g. "get crd*") while transiently failing a different call (e.g. a wait
# call) in the same run. Each invocation is a separate process, so the
# count is tracked in a file next to STUB_LOG.
# shellcheck disable=SC2254
case "$*" in
  ${STUB_KUBECTL_FAIL_ONCE_GLOB:-__never_matches__})
    counter_file="$(dirname "$STUB_LOG")/kubectl_fail_once_count"
    count=$(cat "$counter_file" 2>/dev/null || echo 0)
    limit=${STUB_KUBECTL_FAIL_ONCE_COUNT:-1}
    if [ "$count" -lt "$limit" ]; then
      echo $((count + 1)) > "$counter_file"
      exit 1
    fi
    ;;
esac
# `apply -f -` is the only invocation that pipes meaningful stdin (the
# rendered manifest from fed_apply). Capture it to the same separate log the
# kind stub uses for its own piped config, so tests can assert on manifest
# *content and relative ordering* across multiple applies in one call (e.g.
# "the namespace was applied before the postgres manifest"), not just argv,
# which is identical ("kubectl apply -f -") for every fed_apply call.
case "$*" in
  *"apply -f -"*)
    [ -n "${STUB_STDIN_LOG:-}" ] && cat >> "$STUB_STDIN_LOG"
    ;;
esac
# lib/karmada.sh reads three distinct jsonpath fields off two different
# object kinds (Cluster.spec.secretRef.{name,namespace} and
# Secret.data.kubeconfig) in the course of a single fed_karmada_join call.
# All three would otherwise collide on the single STUB_KUBECTL_OUT value
# below, so each gets its own seam, matched on the jsonpath expression
# itself. Defaults are sane so tests that don't care about the secret
# name/namespace never need to set them.
case "$*" in
  *"jsonpath={.spec.secretRef.name}"*)
    printf '%s' "${STUB_KUBECTL_SECRET_NAME_OUT:-fed-cluster-secret}"
    exit 0
    ;;
  *"jsonpath={.spec.secretRef.namespace}"*)
    printf '%s' "${STUB_KUBECTL_SECRET_NS_OUT:-karmada-system}"
    exit 0
    ;;
  *"jsonpath={.data.kubeconfig}"*)
    printf '%s' "${STUB_KUBECTL_SECRET_KUBECONFIG_OUT:-}"
    exit 0
    ;;
esac
[ -n "${STUB_KUBECTL_OUT:-}" ] && printf '%s' "$STUB_KUBECTL_OUT"
exit 0
